# Server
PORT=8080
HOST=0.0.0.0
DEBUG=False

# Security
SECRET_KEY=                        # generate: openssl rand -hex 32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (injected by Docker Compose — no need to set manually)
# DATABASE_URL=postgresql://spark:pass@db:5432/spark_db

# Cloudinary — https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Anthropic — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Email — Mailpit (runs in Docker, no external account needed)
MAIL_FROM=spark@localhost
MAIL_SERVER=mailpit
MAIL_PORT=1025
